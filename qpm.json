{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/main/qpm.schema.json",
  "version": "0.1.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "Voice Chat",
    "id": "voicechat",
    "version": "1.0.3",
    "url": "https://github.com/HitBoyXx23-dev/beatsaber-voicechat",
    "additionalData": {
      "overrideSoName": "libvoicechat.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "cmake -G \"Ninja\" -DCMAKE_BUILD_TYPE=\"RelWithDebInfo\" -B build",
        "cmake --build ./build"
      ],
      "clean": [
        "cmake --build ./build --target clean"
      ]
    },
    "ndk": "^27.2.12479018",
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs"
    ],
    "qmodIncludeFiles": [],
    "qmodOutput": "VoiceChat.qmod"
  },
  "dependencies": [
    {
      "id": "beatsaber-hook",
      "versionRange": "^6.4.2",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "4008.*",
      "additionalData": {}
    },
    {
      "id": "multiplayer-core",
      "versionRange": "^1.6.7",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "^0.18.3",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "^0.4.55",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.6",
      "additionalData": {
        "includeQmod": false,
        "private": true
      }
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.6.4",
      "additionalData": {
        "private": true
      }
    }
  ]
}
